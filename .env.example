APP_NAME=DevPilot
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite+aiosqlite:///./devpilot.db
CHECKPOINT_DB_PATH=./devpilot_checkpoints.db
DEFAULT_LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3
LOG_LEVEL=INFO
WORKSPACE_BASE_PATH=./workspace
DOCKER_SANDBOX_ENABLED=False
